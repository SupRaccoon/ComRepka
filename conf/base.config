process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'
    maxForks = params.max_jobs
    withLabel: 'python' {
        cpus = 1
        memory = params.python_memory
        time = params.python_time
        conda = "${projectDir}/envs/core.yml"
    }
    withLabel: 'repeatmasker' {
        cpus = params.rm_cpus
        memory = params.rm_memory
        time = params.rm_time
        conda = "${projectDir}/envs/repeatmasker.yml"
    }
    withLabel: 'minimap' {
        cpus = params.minimap_cpus
        memory = params.minimap_memory
        time = params.minimap_time
        conda = "${projectDir}/envs/core.yml"
    }
    withLabel: 'hal' {
        cpus = 1
        memory = params.hal_memory
        time = params.hal_time
        conda = "${projectDir}/envs/core.yml"
    }
}
