// All comments and code identifiers are in English.
nextflow.enable.dsl = 2

manifest {
    name = 'ComRepka'
    description = 'Compare repeats using genomic flanks'
    version = '0.1.0'
    nextflowVersion = '>=25.10.2'
    mainScript = 'main.nf'
}

params {
    genomes = null
    pairs = null
    from = 'genome'
    until = 'statuses'
    outdir = 'results'
    annotate_targets = false
    rm_engine = 'hmmer'
    rm_sensitivity = 's'
    rm_library = null
    rm_reference_id = 'Dfam-3.9_2025-03-10_curated'
    rm_extra_args = []
    rm_cpus = 2
    rm_memory = '16 GB'
    rm_time = '24h'
    target_groups = 'LTR'
    target_repeats = ''
    flank_len = 5000
    nrt_len = 500
    overhang_len = 50
    soft_mask = false
    target_near_keep = 500
    repeat_end_keep = 50
    max_groups = 0
    minimap_preset = 'asm10'
    minimap_secondary = 'yes'
    minimap_N = 20
    minimap_p = 0.8
    minimap_index_args = []
    minimap_extra_args = []
    minimap_cpus = 2
    minimap_memory = '8 GB'
    minimap_time = '24h'
    classify_mode = 'stream'
    classify_max_tsd = 50
    classify_max_empty_gap = 50
    classify_length_tolerance_bp = 100
    classify_length_tolerance_frac = 0.1
    classify_max_pair_distance = 10000
    classify_min_identity = 0.8
    classify_min_query_cover = 0.2
    classify_min_mapq = 0
    classify_primary_only = false
    classify_max_hits_per_side = 20
    classify_min_overhang_aligned = 45
    classify_overhang_edge_slop = 5
    classify_ambiguous_score_delta = 5.0
    classify_high_identity = 0.9
    classify_low_identity = 0.85
    classify_high_query_cover = 0.5
    classify_low_query_cover = 0.3
    classify_high_mapq = -1
    hal_liftover = 'halLiftover'
    hal_version = 'UNRECORDED'
    hal_anchor_len = 300
    hal_anchor_offsets = '0,400'
    hal_min_pred_recall = 0.95
    hal_alt_iou_threshold = 0.2
    hal_len_ratio_max = 2.0
    hal_batch_size = 200000
    python_memory = '8 GB'
    python_time = '4h'
    hal_memory = '16 GB'
    hal_time = '24h'
    slurm_partition = null
    slurm_account = null
    max_jobs = 2
    conda_cache = null
}

includeConfig 'conf/base.config'
profiles {
    local { includeConfig 'conf/local.config' }
    slurm { includeConfig 'conf/slurm.config' }
}
conda.cacheDir = params.conda_cache
trace { enabled = true; file = "${params.outdir}/provenance/trace-${new Date().format("yyyyMMdd-HHmmss")}.tsv"; overwrite = false }
report { enabled = true; file = "${params.outdir}/provenance/report-${new Date().format("yyyyMMdd-HHmmss")}.html"; overwrite = false }
timeline { enabled = true; file = "${params.outdir}/provenance/timeline-${new Date().format("yyyyMMdd-HHmmss")}.html"; overwrite = false }
